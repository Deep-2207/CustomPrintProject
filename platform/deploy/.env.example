# Copy this file to ".env" (same folder) and fill every line in. Never commit ".env".

# The website address, without https://   e.g.  customize.yourbrand.in
DOMAIN=

# Database password. Long and random, e.g. the output of:  openssl rand -base64 24
DB_PASSWORD=

# Secret for the old admin page. Long and random. The app refuses to start with the default.
ADMIN_KEY=

# Your owner login, created on first start if no owner exists yet (password at least 10 characters).
# You can clear OWNER_PASSWORD afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional: GST percent added to invoices (default 18)
GST_PERCENT=18

# Optional: e-mail yourself each landing-page sign-up (they are always saved either way)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
